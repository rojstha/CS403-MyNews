# Copy to backend/.env and fill in. NEVER commit backend/.env (it is git-ignored).
#
# On the Mac this file configures the hourly AI worker (python -m app.ai_worker).
# On Render the same names are set in the dashboard instead (see render.yaml).

# Database. Production: the Neon connection string (contains the password).
# Local experiments: a SQLite file.
DATABASE_URL=postgresql://USER:PASSWORD@ep-EXAMPLE-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL=sqlite:///./mynews.db

# AI provider: ollama (free, local), anthropic (paid API), or none (no AI in this process).
AI_PROVIDER=ollama
AI_MODEL=granite4.2:3b
OLLAMA_URL=http://localhost:11434
OLLAMA_THINK=false
OLLAMA_NUM_PREDICT=2000
OLLAMA_NUM_CTX=8192
# Only if AI_PROVIDER=anthropic:
# ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# AI_EFFORT=medium

# Cost/time guards: at most N summaries per hourly run, only for stories with
# at least this many publishers. Must match AI_MIN_PUBLISHERS on Render.
AI_MAX_SUMMARIES_PER_RUN=10
AI_MIN_PUBLISHERS=2

# Only needed where news is collected (Render):
# ADMIN_TOKEN=replace-with-a-long-random-string
# CONTACT_INFO=https://github.com/YOUR-USER/CS403-MyNews
RETENTION_HOURS=168

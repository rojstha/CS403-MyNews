# Copy to backend/.env for local development. NEVER commit a real .env.
# In production these are set as environment variables on the host (Render dashboard).

# Postgres in production; SQLite file for local development.
DATABASE_URL=sqlite:///./mynews.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Protects POST /admin/collect (manual demo collection). Use a long random string.
ADMIN_TOKEN=replace-with-a-long-random-string

# AI summarisation (server side only; never put this key in the Flutter app).
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
AI_MAX_TOKENS=8000
AI_USE_FALLBACKS=true
# Cost guards: at most this many (re)generations per hourly run, and only for
# stories with at least this many distinct publishers (1 = every story).
AI_MAX_SUMMARIES_PER_RUN=25
AI_MIN_PUBLISHERS=1

# Rolling news window in hours (by publication time).
RETENTION_HOURS=168
FEED_TIMEOUT_SECONDS=15

# Background resources from Wikipedia. Wikimedia blocks requests whose
# User-Agent has no contact details, so include a URL or email address.
BACKGROUND_ENABLED=true
BACKGROUND_MAX_PER_RUN=60
CONTACT_INFO=https://github.com/YOUR-USER/myNews; CS 403 student project
